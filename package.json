{
  "name": "road-to-agi",
  "version": "1.0.0",
  "private": true,
  "description": "Idle clicker: bouw steeds slimmere AI-modellen op weg naar AGI.",
  "scripts": {
    "serve": "npx --yes serve www",
    "assets": "npx capacitor-assets generate --ios --android --iconBackgroundColor \"#060914\" --splashBackgroundColor \"#060914\"",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "sync": "npx cap sync",
    "build:web": "node scripts/build-web.js"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
